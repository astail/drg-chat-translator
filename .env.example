###############################################################################
#  DRGTranslate 設定
#
#  このファイルを同じ場所に「.env」という名前でコピーして使います。
#
#      copy .env.example .env
#
#  すべての項目を既定値つきで書いてあります。行頭の # を外した行だけが
#  設定として反映され、# が付いたままの行は既定値のままになります。
#  つまり「変えたい項目だけ # を外す」使い方です。
#
#  .env は .gitignore 済みなので、APIキーがリポジトリに入ることはありません。
###############################################################################


#==============================================================================
# 1. まずここだけ  ―  翻訳サービスの選択とAPIキー
#==============================================================================

# 使う翻訳サービス。deepl / claude / openai のどれか
#
#   deepl   … 機械翻訳。月50万文字まで無料。pip install 不要
#   claude  … 要 `pip install anthropic`。スラングや誤字に強い
#   openai  … 要 `pip install openai`。同上
#
#DRGT_PROVIDER=deepl


# --- APIキー（使うサービスのものだけ設定すればOK）-----------------------------

# DeepL   https://www.deepl.com/pro-api  無料枠のキーは末尾が :fx
#DEEPL_AUTH_KEY=

# Claude  https://console.anthropic.com/
#ANTHROPIC_API_KEY=

# OpenAI  https://platform.openai.com/api-keys
#OPENAI_API_KEY=


#==============================================================================
# 2. サービスごとの詳細設定
#==============================================================================

# --- DeepL --------------------------------------------------------------------

# 接続先。空ならキーの種類（:fx の有無）から自動で選びます
#DRGT_DEEPL_API_URL=


# --- Claude -------------------------------------------------------------------

# 使うモデル。チャットは短文なので既定の Haiku で十分です。
# 訳が物足りなければ claude-sonnet-5 → claude-opus-5 の順に上げてください。
#   claude-haiku-4-5   $1 / $5   （100万トークンあたり 入力/出力）
#   claude-sonnet-5    $3 / $15
#   claude-opus-5      $5 / $25
#DRGT_CLAUDE_MODEL=claude-haiku-4-5

# 1回の応答の上限トークン数
#DRGT_CLAUDE_MAX_TOKENS=1024

# 思考の深さ。auto / low / medium / high
# 4.6 以降のモデルでのみ有効で、それ以前のモデルでは無視されます
#DRGT_CLAUDE_EFFORT=auto

# 暴言などで翻訳を拒否されたとき、別モデルへ自動で回すか
# auto なら対応モデル（opus-5 等）のときだけ有効になります
#DRGT_CLAUDE_REFUSAL_FALLBACK=auto


# --- OpenAI -------------------------------------------------------------------

# 使うモデル。アカウントで使えるものに合わせてください
#DRGT_OPENAI_MODEL=gpt-4o-mini

# 1回の応答の上限トークン数
#DRGT_OPENAI_MAX_TOKENS=1024

# OpenAI互換の別エンドポイントに向ける場合だけ設定します。
# Ollama / LM Studio などのローカルLLMを指定すれば、
# チャット本文を一切外部に出さずに翻訳できます。
#   例) DRGT_OPENAI_BASE_URL=http://localhost:11434/v1
#DRGT_OPENAI_BASE_URL=


#==============================================================================
# 3. 翻訳の中身
#==============================================================================

# --- 受信（他人の発言を日本語にする）-------------------------------------------

#DRGT_INCOMING_ENABLED=true

# 翻訳先の言語
#DRGT_INCOMING_TARGET=ja

# この言語の発言は自分のチャットに訳を出さない（カンマ区切り）。
# 自分がホストのときの中継（下の DRGT_RELAY_*）はこの設定に関わらず動くので、
# 日本語の発言も他の言語の人には届きます
#DRGT_INCOMING_SKIP_LANGUAGES=ja

# チャット欄への出し方。{sender} {text} {lang} {original} が使えます
#DRGT_INCOMING_FORMAT=[訳] {sender}: {text}

# この文字数を超える発言は翻訳しない
#DRGT_INCOMING_MAX_CHARS=400


# --- 送信（自分の日本語を翻訳して送る）-----------------------------------------

#DRGT_OUTGOING_ENABLED=true

# 翻訳元の言語
#DRGT_OUTGOING_SOURCE=ja

# 翻訳先（カンマ区切り）。英語だけでいいなら en
#   en=英語 / ko=韓国語 / zh=中国語（簡体字・中国大陸） / zh-tw=中国語（繁体字・台湾）
#   増やすほど1行が長くなるので、実用上は3つ程度までがおすすめです
#DRGT_OUTGOING_TARGETS=en,ko,zh

# 複数言語を並べるときの区切り。前後の空白を残したいので引用符で囲みます
#DRGT_OUTGOING_SEPARATOR=" / "

# 翻訳文の前に日本語の原文も付けるか。
# 原文は別メッセージとして先に送られるので、通常は false のままでOKです
#DRGT_OUTGOING_INCLUDE_SOURCE=false

# この文字数を超える発言は翻訳しない
#DRGT_OUTGOING_MAX_CHARS=200


# --- 中継（自分がホストのときだけ、他人の発言の訳を全員に流す）-------------------
#
# 英語の発言なら JP/KR/ZH、韓国語の発言なら JP/EN/ZH、日本語の発言なら
# EN/KR/ZH、というように発言者の言語を除いた訳を作り、1言語ずつチャットに
# 流します。クライアントとして参加しているときは何もしません。
#
# 翻訳は受信ぶんと同じ1回の API 呼び出しにまとめられるので、
# 中継を入れても呼び出し回数は増えません（訳す言語は増えます）。

#DRGT_RELAY_ENABLED=true

# 中継先の言語。発言者の言語は自動で除かれます
#DRGT_RELAY_TARGETS=ja,en,ko,zh

# 1行の書式。{lang}=言語(JP/EN/KR/ZH) {sender}=発言者 {text}=訳 {original}=原文
#DRGT_RELAY_FORMAT="[{lang}] {sender}: {text}"

# この文字数を超える発言は中継しない（長文を4行に増やすと読みづらいため）
#DRGT_RELAY_MAX_CHARS=200

# 1つの発言につき流す最大行数
#DRGT_RELAY_MAX_LINES=4


#==============================================================================
# 4. キャッシュと用語集
#==============================================================================

# 同じ発言を訳し直さないための保存。プロバイダ・モデルごとに分けて保存されます。
# ※他プレイヤーの発言がファイルに残ります。不要なら false にしてください
#DRGT_CACHE_ENABLED=true
#DRGT_CACHE_MAX_ENTRIES=5000
#DRGT_CACHE_PATH=bridge/cache.json

# "Rock and Stone!" のような定型句を、APIを経由せず置き換える対応表
#DRGT_GLOSSARY_ENABLED=true
#DRGT_GLOSSARY_PATH=bridge/glossary.json


#==============================================================================
# 5. オーバーレイ（ゲーム内表示が使えないときの保険となる小窓）
#==============================================================================

# 通常は不要です。ホストで遊んでいて翻訳が出ない場合などに true にしてください。
# ゲームの表示設定を「ウィンドウ(フルスクリーン)」にしないと前面に出ません
#DRGT_OVERLAY_ENABLED=false

# always … 常に表示 / auto … ゲーム内に出せないときだけ / off … 出さない
#DRGT_OVERLAY_MODE=auto

# auto のとき、最後の翻訳からこの秒数が過ぎたら小窓を引っ込める。
# 0 にすると出しっぱなしになります（入力欄を使っている間は引っ込みません）。
#DRGT_OVERLAY_HIDE_AFTER=12

# 表示行数・見た目・位置
#DRGT_OVERLAY_LINES=8
#DRGT_OVERLAY_FONT_SIZE=13
#DRGT_OVERLAY_OPACITY=0.85
#DRGT_OVERLAY_X=40
#DRGT_OVERLAY_Y=40
#DRGT_OVERLAY_WIDTH=520

# 小窓に入力欄を出すか（日本語を打つとゲームのチャットへ送れます）
#DRGT_OVERLAY_COMPOSER=true


#==============================================================================
# 6. 通信とログ（通常は変更不要）
#==============================================================================

# 応答を待つ秒数。deepl 用
#DRGT_TIMEOUT_SEC=6.0

# claude / openai 用。機械翻訳より時間がかかるので別枠にしています
#DRGT_LLM_TIMEOUT_SEC=20.0

# 同時に処理する翻訳の数
#DRGT_MAX_WORKERS=4

# 翻訳リクエストの最小間隔（秒）。レート制限に当たる場合に上げてください
#DRGT_MIN_INTERVAL_SEC=0.0

# debug / info / warning / error
#DRGT_LOG_LEVEL=info
